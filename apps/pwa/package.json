{
  "name": "@vehicleos/pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit PWA de VehicleOS: instrumentación MBUX, diagnóstico, mantenimiento, viajes, mapa y asistente",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
