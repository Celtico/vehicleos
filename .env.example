# Configuración del despliegue con Docker.
# Copia este fichero a .env y ajusta los valores antes de levantar nada.

# ── Base de datos ───────────────────────────────────────────────────
POSTGRES_USER=vehicleos
POSTGRES_DB=vehicleos
# OBLIGATORIA. Genera una con: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Backend ─────────────────────────────────────────────────────────
# OBLIGATORIO. Firma los tokens de sesión: si se filtra, cualquiera puede
# hacerse pasar por cualquier usuario. Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Origen desde el que se sirve el cockpit. Si no coincide con la URL real,
# el navegador bloqueará las peticiones por CORS. Admite lista separada por
# comas, y "*" solo para pruebas.
#
# Con el despliegue de un solo dominio (ver docker/proxy.example.conf), el
# cockpit y la API comparten origen y el CORS deja de intervenir; se deja
# igualmente por si accedes también por IP directa.
CORS_ORIGIN=https://coche.tudominio.com

# Opcional. Sin ella, el asistente responde con diagnóstico local en lugar
# de llamar a Claude.
ANTHROPIC_API_KEY=

# ── URL públicas ────────────────────────────────────────────────────
# IMPORTANTE: son las direcciones a las que llegará el navegador del
# usuario, no nombres internos de Docker ni localhost.
#
# La pantalla del coche, el móvil y la tableta abren el cockpit desde OTRA
# máquina, así que "localhost" apuntaría a ellos mismos y no encontrarían
# nada. Pon aquí la IP del servidor en tu red (o el dominio, si lo pones
# detrás de un proxy).
#
# Se incrustan en el JavaScript durante el build: cambiarlas obliga a
# reconstruir la imagen del cockpit con `docker compose build pwa`.
# ── Opción A: detrás del proxy, un solo dominio (recomendada) ──
# El cockpit ocupa la raíz porque es una PWA (el service worker toma como
# alcance su carpeta, y la instalación desde un subdirectorio es problemática).
# La API cuelga de /api del mismo dominio, así no hay CORS.
PUBLIC_API_URL=https://coche.tudominio.com/api
PUBLIC_WS_URL=https://coche.tudominio.com
PUBLIC_SOCKET_PATH=/api/socket.io

# ── Opción B: acceso directo por IP en la red local ──
# Descomenta estas y comenta las de arriba. Deja PUBLIC_SOCKET_PATH vacía:
# sin proxy, socket.io usa su ruta estándar.
# PUBLIC_API_URL=http://192.168.1.XXX:7272
# PUBLIC_WS_URL=ws://192.168.1.XXX:7272/telemetry
# PUBLIC_SOCKET_PATH=

# ── Puertos publicados en el servidor ───────────────────────────────
# Bloque 7270-7272, elegido para no chocar con los servicios que ya
# tienes en la red. Comprueba antes de levantar:
#   ss -lntp | grep -E ":(7270|7271|7272)\\b"
LANDING_PORT=7270
PWA_PORT=7271
BACKEND_PORT=7272

# ── Nombres detrás del proxy ────────────────────────────────────────
# Hacen falta DOS nombres, y solo por un motivo: la PWA quiere la raíz de
# su dominio, así que la landing no puede compartirlo.
#
#   coche.tudominio.com       → cockpit (raíz) + API en /api
#   vehicleos.tudominio.com   → landing
#
# Ambos pueden ser subdominios del mismo dominio comprado. Ejemplo de
# configuración de nginx en docker/proxy.example.conf.
