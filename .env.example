# Configuración del despliegue con Docker.
# Copia este fichero a .env y ajusta los valores antes de levantar nada.

# ── Base de datos ───────────────────────────────────────────────────
POSTGRES_USER=vehicleos
POSTGRES_DB=vehicleos
# OBLIGATORIA. Genera una con: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Backend ─────────────────────────────────────────────────────────
# OBLIGATORIO. Firma los tokens de sesión: si se filtra, cualquiera puede
# hacerse pasar por cualquier usuario. Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Origen desde el que se sirve el cockpit. Si no coincide con la URL real,
# el navegador bloqueará las peticiones por CORS. Admite lista separada por
# comas, y "*" solo para pruebas.
CORS_ORIGIN=http://localhost:3000

# Opcional. Sin ella, el asistente responde con diagnóstico local en lugar
# de llamar a Claude.
ANTHROPIC_API_KEY=

# ── URL públicas ────────────────────────────────────────────────────
# IMPORTANTE: son las direcciones a las que llegará el navegador del
# usuario, no nombres internos de Docker. Se incrustan en el JavaScript
# durante el build, así que cambiarlas obliga a reconstruir la imagen del
# cockpit (docker compose build pwa).
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3001/telemetry

# ── Puertos publicados en el servidor ───────────────────────────────
LANDING_PORT=8080
PWA_PORT=3000
BACKEND_PORT=3001
