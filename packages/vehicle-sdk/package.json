  },
  "dependencies": {
    "@vehicleos/shared": "workspace:*",
    "@vehicleos/vehicle-protocol": "workspace:*",
    "@vehicleos/vehicle-simulator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
