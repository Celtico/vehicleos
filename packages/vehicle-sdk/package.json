{
  "name": "@vehicleos/vehicle-sdk",
  "version": "0.1.0",
  "description": "SDK de vehículo: interfaz VehicleProvider y sus implementaciones (simulador, Android Bridge, futuros)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
