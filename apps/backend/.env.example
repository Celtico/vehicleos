# Copia este archivo a .env y ajusta los valores.

# Conexión a PostgreSQL (coincide con el docker-compose.yml de este directorio).
DATABASE_URL="postgres://vehicleos:vehicleos@localhost:5432/vehicleos"

# Secreto para firmar los JWT. Cámbialo SIEMPRE en producción.
JWT_SECRET="cambia-este-secreto-en-produccion"

# Clave de la API de Anthropic (opcional). Si no se define, el módulo de IA
# responde con un diagnóstico local determinista en lugar de llamar a Claude.
# ANTHROPIC_API_KEY="sk-ant-..."

# Puerto HTTP/WS del backend.
PORT=3001

# Origen(es) permitidos por CORS. Lista separada por comas, o "*" en
# desarrollo. Por defecto http://localhost:3000 (la PWA en local).
CORS_ORIGIN="http://localhost:3000"
